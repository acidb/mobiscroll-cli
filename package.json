{
  "name": "@mobiscroll/cli",
  "version": "2.0.1",
  "description": "Installs and configures Mobiscroll UI components (Angular, Ionic, React, Vue, JavaScript, jQuery) from the Mobiscroll npm registry",
  "keywords": [
    "mobiscroll",
    "mobiscroll-ui",
    "cli",
    "calendar",
    "scheduler",
    "datepicker",
    "angular",
    "ionic",
    "react",
    "vue",
    "jquery"
  ],
  "homepage": "https://mobiscroll.com/",
  "license": "Apache-2.0",
  "main": "index.js",
  "author": {
    "name": "Mobiscroll",
    "url": "https://mobiscroll.com/"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "@mobiscroll:registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/acidb/mobiscroll-cli.git"
  },
  "bugs": {
    "url": "https://github.com/acidb/mobiscroll-cli/issues"
  },
  "scripts": {
    "test": "mobiscroll",
    "prepublish": "node scripts/normalize-line-endings.js mobiscroll.js"
  },
  "bin": {
    "mobiscroll": "./mobiscroll.js"
  },
  "dependencies": {
    "axios": "^1.16.0",
    "chalk": "^2.4.1",
    "commander": "^2.19.0",
    "figlet": "^1.2.1",
    "inquirer": "^8.1.0",
    "js-yaml": "^4.1.0",
    "ncp": "^2.0.0",
    "semver": "^6.3.0",
    "terminal-link": "^1.2.0"
  },
  "overrides": {
    "external-editor": {
      "tmp": "0.2.4"
    }
  }
}
